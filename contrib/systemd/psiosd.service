[Unit]
Description=PsiOS local system authority
After=local-fs.target

[Service]
Type=notify
NotifyAccess=main
User=psios
Group=psios
StateDirectory=psios psios.witness
StateDirectoryMode=0700
RuntimeDirectory=psios
RuntimeDirectoryMode=0750
UMask=0077
ExecStart=/usr/bin/psiosd --config /etc/psios/core.json serve
Restart=on-failure
RestartSec=3s
TimeoutStartSec=120s
TimeoutStopSec=120s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
