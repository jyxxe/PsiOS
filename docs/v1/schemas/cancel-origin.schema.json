{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.psios.example/v1/cancel-origin.schema.json",
  "title": "CancelOrigin is serialized with submission acceptance",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "origin_ref": {
      "$ref": "https://schemas.psios.example/v1/common.schema.json#/$defs/OriginRef"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "request_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "cancel_scope_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "cancel_request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "origin_ref",
    "idempotency_key",
    "request_digest",
    "cancel_scope_id",
    "cancel_request_id",
    "reason"
  ],
  "additionalProperties": false
}
