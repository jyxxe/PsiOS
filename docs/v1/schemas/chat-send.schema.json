{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.psios.example/v1/chat-send.schema.json",
  "title": "Client SendMessage; sender is derived from authentication",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "conversation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "client_send_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "content_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "content": {
      "type": "object",
      "properties": {
        "parts": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "text"
                  },
                  "text": {
                    "type": "string",
                    "maxLength": 65536
                  }
                },
                "required": [
                  "kind",
                  "text"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "json"
                  },
                  "schema_ref": {
                    "$ref": "https://schemas.psios.example/v1/common.schema.json#/$defs/ResourceRef"
                  },
                  "data": {}
                },
                "required": [
                  "kind",
                  "schema_ref",
                  "data"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "asset_ref"
                  },
                  "asset_ref": {
                    "$ref": "https://schemas.psios.example/v1/common.schema.json#/$defs/ResourceRef"
                  }
                },
                "required": [
                  "kind",
                  "asset_ref"
                ],
                "additionalProperties": false
              }
            ]
          },
          "minItems": 1,
          "maxItems": 256
        }
      },
      "required": [
        "parts"
      ],
      "additionalProperties": false
    },
    "thread_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "reply_to_message_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "mentions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
      },
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true
    },
    "message_type": {
      "enum": [
        "message",
        "request",
        "response",
        "decision",
        "approval_request",
        "task_event"
      ]
    },
    "attachment_refs": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.psios.example/v1/common.schema.json#/$defs/ResourceRef"
      },
      "minItems": 0,
      "maxItems": 256
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "causation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "task_ref": {
      "$ref": "https://schemas.psios.example/v1/common.schema.json#/$defs/ResourceRef"
    }
  },
  "required": [
    "schema_version",
    "conversation_id",
    "client_send_id",
    "content_digest",
    "content",
    "mentions",
    "message_type",
    "attachment_refs"
  ],
  "additionalProperties": false
}
