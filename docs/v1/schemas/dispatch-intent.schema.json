{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.psios.example/v1/dispatch-intent.schema.json",
  "title": "Workflow-to-Task durable dispatch intent",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "intent_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "workflow_run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "step_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "attempt_generation": {
      "$ref": "https://schemas.psios.example/v1/common.schema.json#/$defs/UInt64"
    },
    "submit_request": {
      "$ref": "https://schemas.psios.example/v1/task-submit.schema.json"
    },
    "status": {
      "enum": [
        "Pending",
        "Submitted",
        "Linked",
        "CancelPending",
        "Cancelled",
        "Blocked"
      ]
    },
    "accepted": {
      "$ref": "https://schemas.psios.example/v1/task-accepted.schema.json"
    },
    "cancel_request_ref": {
      "$ref": "https://schemas.psios.example/v1/common.schema.json#/$defs/ResourceRef"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "intent_id",
    "workflow_run_id",
    "step_key",
    "attempt_generation",
    "submit_request",
    "status"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "Linked"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "accepted"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "CancelPending"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "cancel_request_ref"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "Blocked"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "reason"
        ]
      }
    }
  ]
}
