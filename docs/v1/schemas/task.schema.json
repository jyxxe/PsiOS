{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.psios.example/v1/task.schema.json",
  "title": "Task read view; terminal result availability is independent",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "task_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "origin_ref": {
      "$ref": "https://schemas.psios.example/v1/common.schema.json#/$defs/OriginRef"
    },
    "request_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "lifecycle": {
      "enum": [
        "Accepted",
        "Queued",
        "Running",
        "WaitingInput",
        "WaitingApproval",
        "WaitingResource",
        "Paused",
        "Cancelling",
        "Succeeded",
        "Failed",
        "Cancelled"
      ]
    },
    "outcome_knowledge": {
      "enum": [
        "NotStarted",
        "InFlight",
        "Known",
        "Unknown"
      ]
    },
    "cancel_scope_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "current_run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "retry_of_task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "result": {
      "type": "object",
      "properties": {
        "availability": {
          "enum": [
            "Pending",
            "NoneExpected",
            "Available",
            "Evicted",
            "Unavailable"
          ]
        },
        "artifact_refs": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.psios.example/v1/common.schema.json#/$defs/ResourceRef"
          },
          "minItems": 0,
          "maxItems": 4096
        }
      },
      "required": [
        "availability",
        "artifact_refs"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "availability": {
                "const": "Available"
              }
            },
            "required": [
              "availability"
            ]
          },
          "then": {
            "properties": {
              "artifact_refs": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "availability": {
                "const": "NoneExpected"
              }
            },
            "required": [
              "availability"
            ]
          },
          "then": {
            "properties": {
              "artifact_refs": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "operation_refs": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.psios.example/v1/common.schema.json#/$defs/ResourceRef"
      },
      "minItems": 0,
      "maxItems": 4096
    },
    "conditions": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.psios.example/v1/common.schema.json#/$defs/Condition"
      },
      "minItems": 0,
      "maxItems": 64
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "task_revision",
    "origin_ref",
    "request_digest",
    "lifecycle",
    "outcome_knowledge",
    "cancel_scope_id",
    "result",
    "operation_refs",
    "conditions"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "lifecycle": {
            "const": "Succeeded"
          }
        },
        "required": [
          "lifecycle"
        ]
      },
      "then": {
        "properties": {
          "outcome_knowledge": {
            "const": "Known"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome_knowledge": {
            "const": "Unknown"
          }
        },
        "required": [
          "outcome_knowledge"
        ]
      },
      "then": {
        "properties": {
          "conditions": {
            "contains": {
              "type": "object",
              "properties": {
                "type": {
                  "const": "OutcomeUnknown"
                },
                "status": {
                  "const": "True"
                }
              },
              "required": [
                "type",
                "status"
              ]
            },
            "minContains": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lifecycle": {
            "const": "Succeeded"
          }
        },
        "required": [
          "lifecycle"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "properties": {
              "availability": {
                "enum": [
                  "NoneExpected",
                  "Available",
                  "Evicted",
                  "Unavailable"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lifecycle": {
            "const": "WaitingInput"
          }
        },
        "required": [
          "lifecycle"
        ]
      },
      "then": {
        "properties": {
          "conditions": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lifecycle": {
            "const": "WaitingApproval"
          }
        },
        "required": [
          "lifecycle"
        ]
      },
      "then": {
        "properties": {
          "conditions": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lifecycle": {
            "const": "WaitingResource"
          }
        },
        "required": [
          "lifecycle"
        ]
      },
      "then": {
        "properties": {
          "conditions": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lifecycle": {
            "const": "Paused"
          }
        },
        "required": [
          "lifecycle"
        ]
      },
      "then": {
        "properties": {
          "conditions": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
