#!/bin/sh
# The supervisor stays outside the workload cgroup to recover after a limit is hit.
set -eu
[ "$PPID" -eq 1 ] && [ "$(id -u)" -eq 0 ] || exit 1
root=/sys/fs/cgroup
group=$root/psios-core
read -r quota memory pids < /psios-core-limits

verify_limits() {
    [ "$(cat "$group/cgroup.type")" = domain ] &&
        [ "$(cat "$group/cpu.max")" = "$quota 100000" ] &&
        [ "$(cat "$group/cpu.max.burst")" = 0 ] &&
        [ "$(cat "$group/memory.max")" = "$memory" ] &&
        [ "$(cat "$group/memory.swap.max")" = 0 ] &&
        [ "$(cat "$group/memory.oom.group")" = 1 ] &&
        [ "$(cat "$group/pids.max")" = "$pids" ]
}

group_oom_kills() {
    awk '$1 == "oom_group_kill" && $2 ~ /^(0|[1-9][0-9]*)$/ { print $2; found++ }
         END { if (found != 1) exit 1 }' "$group/memory.events.local"
}

record_exit() (
    record=/var/lib/.psios-core-last-exit
    pending=/var/lib/.psios-core-last-exit.pending
    [ "$(stat -c '%u:%g:%a' /var/lib)" = 0:0:755 ] || return 1
    for path in "$record" "$pending"; do
        if [ -e "$path" ] || [ -L "$path" ]; then
            [ -f "$path" ] && [ ! -L "$path" ] || return 1
            [ "$(stat -c '%u:%g:%a:%h' "$path")" = 0:0:600:1 ] || return 1
        fi
    done
    boot_id=$(cat /proc/sys/kernel/random/boot_id) || return 1
    printf '%s\n' "$boot_id" | grep -Eq '^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$' || return 1
    body=$(printf '{"format":1,"boot_id":"%s","wait_status":%s,"oom_group_kill_before":%s,"oom_group_kill_after":%s}' \
        "$boot_id" "$1" "$2" "$3") || return 1
    # An identical crash loop should leave the last complete record in place.
    if [ -f "$record" ] && printf '%s\n' "$body" | cmp -s - "$record"; then return 0; fi
    umask 077
    rm -f "$pending" || return 1
    set -C
    printf '%s\n' "$body" > "$pending" || return 1
    sync -f /var/lib && mv -T "$pending" "$record" && sync -f /var/lib
)

case "${1-}" in
    setup)
        mkdir -p "$root"
        mount -t cgroup2 -o nodev,nosuid,noexec cgroup2 "$root"
        printf '+cpu +memory +pids\n' > "$root/cgroup.subtree_control"
        mkdir "$group"
        printf '%s 100000\n' "$quota" > "$group/cpu.max"
        printf '0\n' > "$group/cpu.max.burst"
        printf '%s\n' "$memory" > "$group/memory.max"
        printf '0\n' > "$group/memory.swap.max"
        printf '1\n' > "$group/memory.oom.group"
        printf '%s\n' "$pids" > "$group/pids.max"
        printf '1\n' > "$group/cgroup.kill"
        verify_limits
        ;;
    serve)
        trap 'printf "PsiOS Core supervisor stopped; retrying\n" >/dev/console; sleep 2' EXIT
        trap 'trap - EXIT; exit 0' TERM INT
        # Fence surviving descendants from the previous daemon before respawn.
        printf '1\n' > "$group/cgroup.kill"
        tries=0
        until grep -qx 'populated 0' "$group/cgroup.events"; do
            [ "$tries" -lt 30 ] || exit 1
            sleep 0.1
            tries=$((tries + 1))
        done
        verify_limits
        oom_before=$(group_oom_kills 2>/dev/null) || oom_before=null
        (
            printf '0\n' > "$group/cgroup.procs"
            IFS= read -r membership < /proc/self/cgroup
            [ "$membership" = 0::/psios-core ] || exit 1
            exec /bin/su -s /bin/sh psios -c 'exec /bin/psiosd serve'
        ) &
        if wait "$!"; then
            exit 0
        else
            status=$?
        fi
        oom_after=$(group_oom_kills 2>/dev/null) || oom_after=null
        if ! record_exit "$status" "$oom_before" "$oom_after"; then
            printf 'PsiOS could not persist the Core process exit record\n' >/dev/console || :
        fi
        exit "$status"
        ;;
    *) exit 1 ;;
esac
