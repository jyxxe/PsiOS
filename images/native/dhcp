#!/bin/sh
# DHCP and static profiles share MAC-bound wired adapter setup.
set -eu
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
profile=${1:-dhcp}
run=/run/psios-network
umask 022
mkdir -p -m 0755 "$run"
static_address=
static_dns=
static6_address=
static6_dns=
slaac_dns=

retry() {
    printf '%s\n' "$1" > "$run/status"
    case "$profile" in dhcp|slaac-rdnss) sleep 15 ;; esac
    exit 1
}

case "$profile" in
    dhcp)
        config=/etc/psios/dhcp-mac
        [ -f "$config" ] && [ ! -L "$config" ] && [ "$(stat -c '%u:%g:%a:%s' "$config")" = 0:0:600:18 ] || retry 'invalid profile file'
        mac=$(head -c 19 "$config")
        ;;
    static)
        . /psios-ipv4
        load_static_ipv4 /etc/psios/static-ipv4 || retry 'invalid static IPv4 profile'
        ;;
    static6|dual)
        . /psios-ipv6
        load_static_ipv6 /etc/psios/static-ipv6 || retry 'invalid static IPv6 profile'
        if [ "$profile" = dual ]; then
            v6_mac=$mac
            . /psios-ipv4
            load_static_ipv4 /etc/psios/static-ipv4 || retry 'invalid static IPv4 profile'
            [ "$v6_mac" = "$mac" ] || retry 'static profiles identify different interfaces'
            set -- $static_dns $static6_dns
            [ "$#" -le 3 ] || retry 'too many static DNS servers'
        fi
        ;;
    slaac|slaac-rdnss)
        . /psios-ipv6
        load_slaac /etc/psios/slaac || retry 'invalid SLAAC profile'
        [ "$profile" = slaac ] || [ -z "$slaac_dns" ] || retry 'unexpected explicit DNS in router discovery profile'
        ;;
    *) retry 'unsupported wired profile' ;;
esac
[ "$(readlink /etc/resolv.conf)" = "$run/resolv.conf" ] || retry 'resolver link does not belong to the wired profile'
printf '%s\n' "$mac" | grep -Eq '^[0-9a-f][02468ace](:[0-9a-f]{2}){5}$' || retry 'invalid MAC address'
[ "${#mac}" -eq 17 ] && [ "$mac" != 00:00:00:00:00:00 ] || retry 'invalid MAC address'
driver=virtio_net
transport=virtio
module=/psios-e1000e.ko
if [ -e "$module" ] || [ -L "$module" ]; then
    [ -f "$module" ] && [ ! -L "$module" ] &&
        grep -Eq '^[0-9a-f]{64}  /psios-e1000e\.ko$' /psios-payload.sha256 || retry 'invalid e1000e deployment'
    driver=e1000e
    transport=e1000e
    [ -d /sys/module/e1000e ] || insmod "$module" || retry 'could not load the e1000e network driver'
else
    modprobe "$driver" || retry 'could not load the virtio network driver'
fi

link=
for device in /sys/class/net/*; do
    [ -r "$device/address" ] && [ "$(cat "$device/address")" = "$mac" ] || continue
    bound=$(readlink "$device/device/driver" || :)
    [ "${bound##*/}" = "$driver" ] || continue
    [ -z "$link" ] || retry 'MAC address matches multiple interfaces'
    link=${device##*/}
done
[ -n "$link" ] || retry "configured $transport interface is absent"
case "$link" in *[!a-zA-Z0-9_.-]*) retry 'unsupported interface name' ;; esac

ipv6_sysctls=/proc/sys/net/ipv6/conf/$link
if [ "$profile" = slaac-rdnss ]; then
    for option in accept_ra autoconf accept_redirects disable_ipv6; do
        printf '0\n' > "$ipv6_sysctls/$option" || retry 'could not apply the IPv6 discovery policy'
    done
    for option in accept_dad dad_transmits; do
        printf '1\n' > "$ipv6_sysctls/$option" || retry 'could not enable IPv6 duplicate address detection'
    done
    rm -f -- "$run/resolv.conf" || retry 'could not reset the router resolver state'
    [ "$(id -u dhcpcd)" = 76 ] && [ "$(id -g dhcpcd)" = 76 ] || retry 'router discovery service account is unavailable'
    [ ! -L /var/lib/dhcpcd ] && mkdir -p -m 0700 /var/lib/dhcpcd &&
        [ "$(stat -c '%u:%g:%a' /var/lib/dhcpcd)" = 0:0:700 ] || retry 'could not protect router discovery state'
    printf 'IPv6 router discovery with RDNSS on %s\n' "$link" > "$run/status"
    exec /sbin/dhcpcd -6 -B -f /psios-rdnss.conf --env "PSIOS_RDNSS_INTERFACE=$link" "$link"
elif [ "$profile" = slaac ]; then
    for option in accept_ra autoconf accept_ra_defrtr accept_ra_pinfo accept_dad dad_transmits; do
        printf '1\n' > "$ipv6_sysctls/$option" || retry 'could not enable IPv6 router discovery'
    done
    for option in accept_redirects disable_ipv6; do
        printf '0\n' > "$ipv6_sysctls/$option" || retry 'could not apply the IPv6 discovery policy'
    done
    apply_slaac_profile || retry 'could not start IPv6 router discovery'
    printf 'IPv6 router discovery enabled on %s\n' "$link" > "$run/status"
    exit 0
elif [ -z "$static6_address" ]; then
    printf '1\n' > "$ipv6_sysctls/disable_ipv6" || retry 'could not apply the IPv4-only profile'
else
    for option in accept_ra autoconf accept_redirects; do
        printf '0\n' > "$ipv6_sysctls/$option" || retry 'could not constrain the static IPv6 interface'
    done
    for option in accept_dad dad_transmits; do
        printf '1\n' > "$ipv6_sysctls/$option" || retry 'could not enable IPv6 duplicate address detection'
    done
    printf '0\n' > "$ipv6_sysctls/disable_ipv6" || retry 'could not enable IPv6 on the static interface'
fi
ip link set dev "$link" up || retry 'could not bring up the interface'
if [ "$profile" != dhcp ]; then
    . /psios-static
    case "$profile" in
        static) family=IPv4; description=$static_address ;;
        static6) family=IPv6; description=$static6_address ;;
        dual) family='dual stack'; description="$static_address and $static6_address" ;;
    esac
    apply_static_profile || retry "Could not apply static $family on $link"
    printf 'Static %s on %s\n' "$description" "$link" > "$run/status"
    exit 0
fi
modprobe af_packet || retry 'could not load the DHCP packet driver'
export PSIOS_DHCP_INTERFACE="$link" PSIOS_DHCP_MAC="$mac"
PSIOS_DHCP_IFINDEX=$(cat "/sys/class/net/$link/ifindex")
export PSIOS_DHCP_IFINDEX
printf 'Waiting for a lease on %s\n' "$link" > "$run/status"
exec udhcpc -f -R -i "$link" -s /psios-dhcp-event -t 3 -T 3 -A 15 -o -O staticroutes -O subnet -O router -O dns >/dev/null 2>&1
