#!/bin/sh
# BusyBox init supervises this optional, local-console development profile.
set -eu
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
config=/etc/psios/dhcp-mac
run=/run/psios-network

retry() {
    printf 'PsiOS DHCP: %s\n' "$1" >&2
    sleep 15
    exit 1
}

[ -f "$config" ] && [ ! -L "$config" ] && [ "$(stat -c '%u:%g:%a:%s' "$config")" = 0:0:600:18 ] || retry 'invalid profile file'
[ "$(readlink /etc/resolv.conf)" = "$run/resolv.conf" ] || retry 'resolver link does not belong to the DHCP profile'
mac=$(head -c 19 "$config")
printf '%s\n' "$mac" | grep -Eq '^[0-9a-f][02468ace](:[0-9a-f]{2}){5}$' || retry 'invalid MAC address'
[ "${#mac}" -eq 17 ] && [ "$mac" != 00:00:00:00:00:00 ] || retry 'invalid MAC address'
modprobe virtio_net && modprobe af_packet || retry 'could not load the virtio network driver'

link=
for device in /sys/class/net/*; do
    [ -r "$device/address" ] && [ "$(cat "$device/address")" = "$mac" ] || continue
    driver=$(readlink "$device/device/driver" || :)
    [ "${driver##*/}" = virtio_net ] || continue
    [ -z "$link" ] || retry 'MAC address matches multiple interfaces'
    link=${device##*/}
done
[ -n "$link" ] || retry 'configured virtio interface is absent'
case "$link" in *[!a-zA-Z0-9_.-]*) retry 'unsupported interface name' ;; esac

mkdir -p -m 0755 "$run"
export PSIOS_DHCP_INTERFACE="$link" PSIOS_DHCP_MAC="$mac"
PSIOS_DHCP_IFINDEX=$(cat "/sys/class/net/$link/ifindex")
export PSIOS_DHCP_IFINDEX
printf '1\n' > "/proc/sys/net/ipv6/conf/$link/disable_ipv6" || retry 'could not apply the IPv4-only profile'
ip link set dev "$link" up || retry 'could not bring up the interface'
exec udhcpc -f -R -i "$link" -s /psios-dhcp-event -t 3 -T 3 -A 15 -o -O subnet -O router -O dns
