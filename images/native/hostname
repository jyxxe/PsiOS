#!/bin/sh
set -eu
export PATH=/usr/sbin:/usr/bin:/sbin:/bin LC_ALL=C
bb=/bin/busybox

fail() {
    printf 'psios-hostname: %s\n' "$1" >&2
    exit 1
}

valid_name() {
    case "$1" in
        ''|-*|*-|*[!A-Za-z0-9-]*) return 1 ;;
    esac
    [ "${#1}" -le 63 ]
}

checked_file() {
    if [ ! -e "$1" ] && [ ! -L "$1" ]; then
        return 0
    fi
    [ -f "$1" ] && [ ! -L "$1" ] || return 1
    case "$(stat -c '%u:%g:%a:%h' "$1")" in
        0:0:444:1|0:0:644:1) return 0 ;;
        *) return 1 ;;
    esac
}

configured() {
    checked_file "$1" || fail "unsafe hostname file"
    if [ ! -e "$1" ]; then
        printf 'psios\n'
        return
    fi
    bytes=$(wc -c < "$1")
    [ "$bytes" -ge 1 ] && [ "$bytes" -le 64 ] || fail "invalid configured hostname length"
    name=$(cat "$1")
    valid_name "$name" || fail "invalid configured hostname"
    if ! printf '%s\n' "$name" | cmp -s - "$1"; then
        printf '%s' "$name" | cmp -s - "$1" || fail "invalid configured hostname bytes"
    fi
    printf '%s\n' "$name"
}

change() {
    [ "$(id -u)" = 0 ] || fail "changing the hostname requires root"
    valid_name "$1" || fail "hostname must be a single DNS label of 1 to 63 ASCII letters, digits or hyphens"
    for dir in /run /etc /var/lib/etc; do
        [ -d "$dir" ] && [ ! -L "$dir" ] && [ "$(stat -c '%u:%g:%a' "$dir")" = 0:0:755 ] ||
            fail "expected verified root-owned configuration directories"
    done
    [ "$(stat -c '%d:%i' /etc)" = "$(stat -c '%d:%i' /var/lib/etc)" ] ||
        fail "native persistent configuration is not mounted"
    lock=/run/psios-hostname.lock
    if [ -e "$lock" ] || [ -L "$lock" ]; then
        [ -f "$lock" ] && [ ! -L "$lock" ] && [ "$(stat -c '%u:%g:%a:%h' "$lock")" = 0:0:600:1 ] ||
            fail "unsafe hostname lock"
    fi
    umask 077
    exec 9>>"$lock"
    "$bb" flock -x -n 9 || fail "another hostname change is active"
    path=/etc/hostname
    checked_file "$path" || fail "unsafe hostname file"
    pending=/etc/.psios-hostname.pending
    if [ -e "$pending" ] || [ -L "$pending" ]; then
        [ -f "$pending" ] && [ ! -L "$pending" ] || fail "unsafe pending hostname file"
        case "$(stat -c '%u:%g:%a:%h' "$pending")" in
            0:0:600:1|0:0:644:1) rm -- "$pending" ;;
            *) fail "unsafe pending hostname file" ;;
        esac
    fi
    trap 'rm -f -- "$pending"' EXIT
    (set -C; printf '%s\n' "$1" > "$pending")
    chmod 0644 "$pending"
    sync -f /etc
    mv -T -- "$pending" "$path"
    sync -f /etc
    "$bb" hostname "$1" || fail "hostname was persisted but the kernel update failed"
    "$bb" hostname
}

case "$#:${1:-show}" in
    0:show|1:show) "$bb" hostname ;;
    1:configured) configured /etc/hostname ;;
    1:--boot)
        [ "$PPID" = 1 ] && [ "$(id -u)" = 0 ] || fail "boot mode requires the native init process"
        name=$(configured /var/lib/etc/hostname)
        "$bb" hostname "$name"
        ;;
    2:set) change "$2" ;;
    *) fail "usage: psios-hostname [show | configured | set NAME]" ;;
esac
