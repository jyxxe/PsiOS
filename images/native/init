#!/bin/sh
# PID 1 of the independent amd64 VM candidate. The writable persistent
# mounts use filesystem identities pinned when this disk was constructed.
set -eu
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
bb=/bin/busybox
stage=bootstrap
payload_verified=no
abort_boot() {
    trap - EXIT
    echo "PsiOS boot stopped at $stage; use external rescue media" >/dev/console || :
    if [ "$payload_verified" = yes ]; then
        "$bb" sh /psios-shutdown --mounts-only || :
    fi
    "$bb" poweroff -f
}
trap abort_boot EXIT
"$bb" mount -t devtmpfs devtmpfs /dev
"$bb" mount -t proc proc /proc
"$bb" mount -t sysfs sysfs /sys
"$bb" chmod 0755 /
"$bb" --install -s
stage=deployment-payload
"$bb" sha256sum -c /psios-payload.sha256 >/dev/null
payload_verified=yes
"$bb" hostname psios
if [ -f /psios-core-limits ]; then
    stage=core-resource-limits
    /bin/sh /psios-core-cgroup setup
fi
stage=temporary-storage
mkdir -p /tmp
[ -d /tmp ] && [ ! -L /tmp ] || exit 1
mount -t tmpfs -o nodev,nosuid,size=32m,nr_inodes=4096,mode=1777 tmpfs /tmp
stage=loopback
"$bb" ip link set lo up
stage=state-device
/usr/sbin/modprobe virtio_blk
/usr/sbin/modprobe ext4
id=$(cat /psios-disk-uuid)
home_id=$(cat /psios-home-uuid)
. /psios-storage
select_boot_storage
mkdir -p /var/lib /run/psios /home /root /mnt/psios-homes
stage=state-device
mount -t ext4 -o nodev,nosuid,noexec "$state_device" /var/lib
[ "$(stat -c '%u:%g:%a' /var/lib)" = 0:0:755 ]
[ "$(stat -c '%u:%g:%a' /var/lib/deployment-uuid)" = 0:0:444 ]
[ "$(cat /var/lib/deployment-uuid)" = "$id" ]
stage=host-config
[ "$(stat -c '%u:%g:%a' /var/lib/etc)" = 0:0:755 ]
[ "$(stat -c '%u:%g:%a' /var/lib/etc/shadow)" = 0:0:600 ]
mount -o bind /var/lib/etc /etc
if [ -f /psios-core-limits ]; then
    stage=core-service-config
    [ -f /etc/inittab ] && [ ! -L /etc/inittab ] || exit 1
    case "$(stat -c '%u:%g:%a:%h' /etc/inittab)" in
        0:0:600:1|0:0:644:1) ;;
        *) exit 1 ;;
    esac
    [ "$(grep -Fxc '::respawn:/bin/sh /psios-core-cgroup serve' /etc/inittab)" = 1 ]
fi
chmod 0700 /run/psios
chown 1000:1000 /run/psios
stage=home-mount
mount -t ext4 -o nodev,nosuid "$home_device" /mnt/psios-homes
[ "$(stat -c '%u:%g:%a' /mnt/psios-homes)" = 0:0:755 ]
for name in psios root; do
    dir=/mnt/psios-homes/$name
    [ -d "$dir" ] && [ ! -L "$dir" ] || exit 1
done
[ "$(stat -c '%u:%g' /mnt/psios-homes/psios)" = 1000:1000 ]
[ "$(stat -c '%u:%g' /mnt/psios-homes/root)" = 0:0 ]
mkdir -p /home/psios
mount -o bind /mnt/psios-homes/psios /home/psios
mount -o bind /mnt/psios-homes/root /root
stage=authority
. /psios-enroll
enroll_authority
trap - EXIT
exec /bin/busybox init
