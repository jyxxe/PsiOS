#!/bin/sh
# PID 1 of the independent amd64 VM candidate. The only writable persistent
# mount is the filesystem selected when this particular disk was constructed.
set -eu
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
bb=/bin/busybox
stage=bootstrap
trap 'echo "PsiOS boot stopped at $stage; use external rescue media" >/dev/console; "$bb" poweroff -f' EXIT
"$bb" mount -t devtmpfs devtmpfs /dev
"$bb" mount -t proc proc /proc
"$bb" mount -t sysfs sysfs /sys
"$bb" chmod 0755 /
"$bb" --install -s
"$bb" hostname psios
stage=loopback
"$bb" ip link set lo up
stage=state-device
/usr/sbin/modprobe virtio_blk
/usr/sbin/modprobe ext4
i=0
while [ ! -b /dev/vda2 ] && [ "$i" -lt 50 ]; do sleep 0.1; i=$((i+1)); done
set -- /sys/class/block/vd?
[ "$#" -eq 1 ] && [ "$1" = /sys/class/block/vda ] || exit 1
id=$(cat /psios-disk-uuid)
blkid /dev/vda2 | grep -F " UUID=\"$id\"" >/dev/null
mkdir -p /var/lib /run/psios /home/psios /root
mount -t ext4 -o nodev,nosuid,noexec /dev/vda2 /var/lib
[ "$(stat -c '%u:%g:%a' /var/lib)" = 0:0:755 ]
[ "$(stat -c '%u:%g:%a' /var/lib/deployment-uuid)" = 0:0:444 ]
[ "$(cat /var/lib/deployment-uuid)" = "$id" ]
stage=host-config
[ "$(stat -c '%u:%g:%a' /var/lib/etc)" = 0:0:755 ]
[ "$(stat -c '%u:%g:%a' /var/lib/etc/shadow)" = 0:0:600 ]
mount -o bind /var/lib/etc /etc
chmod 0700 /run/psios /home/psios /root
chown 1000:1000 /run/psios /home/psios
stage=authority
if [ -f /var/lib/initialize-once ]; then
    [ "$(stat -c '%u:%g:%a' /var/lib/initialize-once)" = 0:0:444 ]
    [ ! -e /var/lib/initialization-issued ] && [ ! -e /var/lib/psios ] && [ ! -e /var/lib/psios.witness ] || exit 1
    mv /var/lib/initialize-once /var/lib/initialization-issued
    sync -f /var/lib
    mkdir -m 0700 /var/lib/psios /var/lib/psios.witness
    chown 1000:1000 /var/lib/psios /var/lib/psios.witness
    su -s /bin/sh psios -c 'exec /bin/psiosd init'
fi
[ -f /var/lib/initialization-issued ]
su -s /bin/sh psios -c 'exec /bin/psiosd check'
trap - EXIT
exec /bin/busybox init
