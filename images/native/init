#!/bin/sh
# PID 1 of the independent amd64 VM candidate. The writable persistent
# mounts use filesystem identities pinned when this disk was constructed.
set -eu
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
bb=/bin/busybox
stage=bootstrap
payload_verified=no
state_verified=no
trial_boot=no
secure_boot_enforced=no
# This path is in the EFI application's initramfs and is checked before
# mounting any persistent filesystem. The kernel command line selects no mode.
if [ -e /psios-trial-config.sha256 ] || [ -L /psios-trial-config.sha256 ]; then
    trial_boot=yes
fi

record_boot_failure() (
    record=/var/lib/.psios-boot-failure
    pending=/var/lib/.psios-boot-failure.pending
    # PID 1 owns the verified root directory and no service has started.
    # Preserve the last complete record across an interrupted replacement.
    for path in "$record" "$pending"; do
        if [ -e "$path" ] || [ -L "$path" ]; then
            [ -f "$path" ] && [ ! -L "$path" ] || return 1
            [ "$(stat -c '%u:%g:%a:%h' "$path")" = 0:0:600:1 ] || return 1
        fi
    done
    boot_id=$(cat /proc/sys/kernel/random/boot_id) || return 1
    printf '%s\n' "$boot_id" | grep -Eq '^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$' || return 1
    umask 077
    rm -f "$pending" || return 1
    set -C
    printf '{"format":1,"boot_id":"%s","stage":"%s"}\n' "$boot_id" "$stage" > "$pending" || return 1
    sync -f /var/lib && mv -T "$pending" "$record" && sync -f /var/lib
)

abort_boot() {
    trap - EXIT
    if [ "$trial_boot" = yes ]; then
        printf '\nPSIOS-TRIAL/1 {"status":"Failed","stage":"%s"}\n' "$stage" >/dev/console || :
    fi
    echo "PsiOS boot stopped at $stage; use external rescue media" >/dev/console || :
    if [ "$state_verified" = yes ] && ! record_boot_failure; then
        echo "PsiOS could not persist the boot failure on the verified state volume" >/dev/console || :
    fi
    if [ "$payload_verified" = yes ]; then
        "$bb" sh /psios-shutdown --mounts-only || :
    fi
    "$bb" poweroff -f
}

configured_hostname() {
    local path=/var/lib/etc/hostname name bytes
    if [ ! -e "$path" ] && [ ! -L "$path" ]; then
        return 0
    fi
    [ -f "$path" ] && [ ! -L "$path" ] || return 1
    case "$(stat -c '%u:%g:%a:%h' "$path")" in
        0:0:444:1|0:0:644:1) ;;
        *) return 1 ;;
    esac
    bytes=$(stat -c '%s' "$path")
    [ "$bytes" -ge 1 ] && [ "$bytes" -le 64 ] || return 1
    name=$(cat "$path")
    case "$name" in
        ""|-*|*-|*[!A-Za-z0-9-]*) return 1 ;;
    esac
    [ "${#name}" -le 63 ] || return 1
    # Compare the raw file so embedded control bytes cannot disappear during
    # command substitution. Accept the label with or without a final newline.
    if ! printf '%s\n' "$name" | cmp -s - "$path"; then
        printf '%s' "$name" | cmp -s - "$path" || return 1
    fi
    "$bb" hostname "$name"
}

machine_identity() {
    local identity=/var/lib/etc/machine-id pending=/var/lib/etc/.psios-machine-id.pending generated
    if [ -e "$identity" ] || [ -L "$identity" ]; then
        [ -f "$identity" ] && [ ! -L "$identity" ] || return 1
        case "$(stat -c '%u:%g:%a:%h' "$identity")" in
            0:0:444:1|0:0:644:1) ;;
            *) return 1 ;;
        esac
        [ "$(wc -c < "$identity")" -eq 33 ] || return 1
        grep -Eq '^[0-9a-f]{32}$' "$identity" || return 1
        [ "$(cat "$identity")" != 00000000000000000000000000000000 ]
        return
    fi

    # Only PID 1 can write this root-owned directory during early boot. A cut
    # before rename can leave this private file. No consumer could have read it.
    if [ -e "$pending" ] || [ -L "$pending" ]; then
        [ -f "$pending" ] && [ ! -L "$pending" ] || return 1
        case "$(stat -c '%u:%g:%a:%h' "$pending")" in
            0:0:600:1|0:0:444:1) ;;
            *) return 1 ;;
        esac
        rm "$pending"
    fi
    generated=$(tr -d '-' < /proc/sys/kernel/random/uuid)
    printf '%s\n' "$generated" | grep -Eq '^[0-9a-f]{32}$'
    [ "$generated" != 00000000000000000000000000000000 ]
    (umask 077; set -C; printf '%s\n' "$generated" > "$pending")
    chmod 0444 "$pending"
    sync -f /var/lib
    mv -T "$pending" "$identity"
    sync -f /var/lib
}

check_home_directories() {
    local dir name
    [ "$(stat -c '%u:%g:%a' /mnt/psios-homes)" = 0:0:755 ]
    for name in psios root; do
        dir=/mnt/psios-homes/$name
        [ -d "$dir" ] && [ ! -L "$dir" ] || return 1
    done
    [ "$(stat -c '%u:%g' /mnt/psios-homes/psios)" = 1000:1000 ]
    [ "$(stat -c '%u:%g' /mnt/psios-homes/root)" = 0:0 ]
}

install_default_hosts() {
    local hosts=/etc/hosts pending=/etc/.psios-hosts.pending
    if [ -e "$hosts" ] || [ -L "$hosts" ]; then
        [ -f "$hosts" ] && [ ! -L "$hosts" ] || return 1
        case "$(stat -c '%u:%g:%a:%h' "$hosts")" in
            0:0:444:1|0:0:644:1) return 0 ;;
            *) return 1 ;;
        esac
    fi

    # PID 1 has exclusive access to the root-owned directory at this stage.
    # Recreate any unpublished default left by a power cut.
    rm -f -- "$pending"
    (umask 077; set -C; printf '%s\n' '127.0.0.1 localhost' '::1 localhost' > "$pending")
    chmod 0644 "$pending"
    sync -f /etc
    mv -T "$pending" "$hosts"
    sync -f /etc
}

run_trial() {
    local config=/var/lib/etc/psios/core.json dir path manifest_digest
    stage=trial-configuration
    for dir in /var/lib/etc /var/lib/etc/psios; do
        [ -d "$dir" ] && [ ! -L "$dir" ] && [ "$(stat -c '%u:%g:%a' "$dir")" = 0:0:755 ] || return 1
    done
    [ -f "$config" ] && [ ! -L "$config" ] || return 1
    case "$(stat -c '%u:%g:%a:%h' "$config")" in
        0:0:444:1|0:0:644:1) ;;
        *) return 1 ;;
    esac
    # Compare and use one bounded copy. Persisted /etc is never bound, so it
    # cannot change the service credentials, shell environment or init actions.
    head -c 65537 "$config" > /psios-trial-core.json
    chmod 0444 /psios-trial-core.json
    sha256sum -c /psios-trial-config.sha256 >/dev/null

    stage=home-mount
    mount -t ext4 -o ro,noload,nodev,nosuid,noexec "$home_device" /mnt/psios-homes
    check_home_directories

    stage=trial-authority
    . /psios-enroll
    enrollment_marker /var/lib/initialization-issued
    for path in /var/lib/initialize-once /var/lib/enrollment-preparing /var/lib/enrollment-ready; do
        absent "$path"
    done
    enrollment_dir /var/lib/psios 1000:1000:700
    enrollment_dir /var/lib/psios.witness 1000:1000:700
    printf 'psios-trial:x:1000:1000::/:/bin/sh\n' >> /etc/passwd
    printf 'psios-trial:x:1000:\n' >> /etc/group
    su -s /bin/sh psios-trial -c \
        'SQLITE_TMPDIR=/tmp exec /bin/busybox timeout -k 5 120 /bin/psiosd --config /psios-trial-core.json check' >/dev/null

    stage=trial-unmount
    sync -f /var/lib
    umount /mnt/psios-homes
    umount /var/lib
    umount /tmp

    stage=trial-report
    manifest_digest=$(sha256sum /psios-deployment.json)
    if [ "$secure_boot_enforced" = yes ]; then
        printf '\nPSIOS-SECURE-BOOT/1 Enforced\n' >/dev/console
    fi
    printf '\nPSIOS-TRIAL/1 {"status":"Ready","deployment_manifest_sha256":"%s"}\n' \
        "${manifest_digest%% *}" >/dev/console
    trap - EXIT
    exec "$bb" poweroff -f
}

trap abort_boot EXIT
case "${1-}" in
    '')
        "$bb" mount -t devtmpfs devtmpfs /dev
        "$bb" mount -t proc proc /proc
        "$bb" mount -t sysfs sysfs /sys
        "$bb" chmod 0755 /
        "$bb" --install -s
        ;;
    --mounted-root)
        stage=mounted-system-root
        [ "$$" = 1 ]
        "$bb" awk '$5 == "/" && / - tmpfs psios-system / { mounted = 1 }
                   END { exit !mounted }' /proc/self/mountinfo
        ;;
    *) exit 1 ;;
esac
stage=deployment-payload
"$bb" sha256sum -c /psios-payload.sha256 >/dev/null
if [ "$trial_boot" = yes ]; then
    for path in /psios-trial-config.sha256 /psios-trial-disk-id; do
        [ -f "$path" ] && [ ! -L "$path" ] || exit 1
    done
fi
for requires_secure_boot in /psios-secure-boot-required /psios-trial-secure-boot-required; do
    if [ ! -e "$requires_secure_boot" ] && [ ! -L "$requires_secure_boot" ]; then
        continue
    fi
    stage=secure-boot-not-enforced
    [ -f "$requires_secure_boot" ] && [ ! -L "$requires_secure_boot" ] || exit 1
    case "$trial_boot:$requires_secure_boot" in
        no:/psios-secure-boot-required)
            "$bb" grep -Eq '^[0-9a-f]{64}  /psios-secure-boot-required$' /psios-payload.sha256
            ;;
        yes:/psios-trial-secure-boot-required) ;;
        *) exit 1 ;;
    esac
    # The pinned kernel reports EFI enforcement during early boot. This check
    # runs before loading persisted code or mounting writable authority state.
    "$bb" dmesg | "$bb" grep -Eiq 'secure boot enabled|locked down from EFI Secure Boot'
    secure_boot_enforced=yes
done
payload_verified=yes
if [ "${1-}" != --mounted-root ]; then
    stage=mounted-system-root
    system_root=/psios-system-root
    mkdir -m 0755 "$system_root"
    # The factory accepts 128 MiB of Core archive members. Allow room for the
    # pinned kernel's boot tree and the additional verified runtime payloads.
    mount -t tmpfs -o nodev,nosuid,size=256m,nr_inodes=16384,mode=0755 psios-system "$system_root"
    for entry in /* /.[!.]* /..?*; do
        case "$entry" in
            "$system_root") continue ;;
            /dev|/proc|/sys) mkdir -m 0755 "$system_root$entry" ;;
            *)
                if [ -e "$entry" ] || [ -L "$entry" ]; then
                    cp -a "$entry" "$system_root/"
                fi
                ;;
        esac
    done
    mount --move /proc "$system_root/proc"
    mount --move /sys "$system_root/sys"
    mount --move /dev "$system_root/dev"
    exec "$bb" switch_root "$system_root" /psios-init --mounted-root
fi
stage=timezone-data
mkdir -p /usr/share/zoneinfo
tar -xf /psios-zoneinfo.tar -C /usr/share/zoneinfo
"$bb" hostname psios
if [ -f /psios-core-limits ]; then
    stage=core-resource-limits
    /bin/sh /psios-core-cgroup setup
fi
stage=temporary-storage
mkdir -p /tmp
[ -d /tmp ] && [ ! -L /tmp ] || exit 1
mount -t tmpfs -o nodev,nosuid,size=32m,nr_inodes=4096,mode=1777 tmpfs /tmp
if [ "$trial_boot" = no ]; then
    stage=runtime-directory
    mkdir -p /run
    [ -d /run ] && [ ! -L /run ] || exit 1
    mount -t tmpfs -o nodev,nosuid,noexec,size=8m,nr_inodes=1024,mode=0755 tmpfs /run
    stage=shared-memory
    mkdir -p /dev/shm
    mount -t tmpfs -o nodev,nosuid,noexec,size=16m,nr_inodes=1024,mode=1777 tmpfs /dev/shm
    stage=pseudo-terminals
    mkdir -p /dev/pts
    mount -t devpts -o nosuid,noexec,newinstance,ptmxmode=0666,mode=0600,max=64 devpts /dev/pts
    stage=loopback
    "$bb" ip link set lo up
fi
stage=state-device
/usr/sbin/modprobe virtio_blk
/usr/sbin/modprobe nvme_core multipath=0
/usr/sbin/modprobe nvme async_probe=0
/usr/sbin/modprobe sd_mod
/usr/sbin/modprobe ext4
id=$(cat /psios-disk-uuid)
home_id=$(cat /psios-home-uuid)
. /psios-storage
select_boot_storage
if [ "$trial_boot" = yes ]; then
    stage=trial-disk
    # The primary GPT header starts in sector 1 and stores the disk GUID at
    # byte 56. Compare the on-disk byte order against the EFI payload.
    disk_id=$(od -An -v -tx1 -j 568 -N 16 "$deployment_disk" | tr -d '[:space:]')
    [ "$disk_id" = "$(cat /psios-trial-disk-id)" ]
fi
mkdir -p /var/lib /run/psios /home /root /mnt/psios-homes
stage=state-device
mount -t ext4 -o nodev,nosuid,noexec "$state_device" /var/lib
[ "$(stat -c '%u:%g:%a' /var/lib)" = 0:0:755 ]
[ "$(stat -c '%u:%g:%a' /var/lib/deployment-uuid)" = 0:0:444 ]
[ "$(cat /var/lib/deployment-uuid)" = "$id" ]
if [ "$trial_boot" = yes ]; then
    run_trial
    exit 1
fi
state_verified=yes
stage=host-config
[ -d /var/lib/etc ] && [ ! -L /var/lib/etc ] || exit 1
[ "$(stat -c '%u:%g:%a' /var/lib/etc)" = 0:0:755 ]
[ "$(stat -c '%u:%g:%a' /var/lib/etc/shadow)" = 0:0:600 ]
stage=host-name
configured_hostname
stage=machine-identity
machine_identity
stage=host-config
mount -o bind /var/lib/etc /etc
stage=host-resolution
install_default_hosts
if [ -f /psios-core-limits ]; then
    stage=core-service-config
    [ -f /etc/inittab ] && [ ! -L /etc/inittab ] || exit 1
    case "$(stat -c '%u:%g:%a:%h' /etc/inittab)" in
        0:0:600:1|0:0:644:1) ;;
        *) exit 1 ;;
    esac
    [ "$(grep -Fxc '::respawn:/bin/sh /psios-core-cgroup serve' /etc/inittab)" = 1 ]
fi
chmod 0700 /run/psios
chown 1000:1000 /run/psios
stage=home-mount
mount -t ext4 -o nodev,nosuid "$home_device" /mnt/psios-homes
check_home_directories
mkdir -p /home/psios
mount -o bind /mnt/psios-homes/psios /home/psios
mount -o bind /mnt/psios-homes/root /root
stage=authority
. /psios-enroll
enroll_authority
trap - EXIT
exec /bin/busybox init
