#!/bin/sh
# PID 1 invokes this hook after stopping respawn or during verified early boot.
[ "$PPID" -eq 1 ] && [ "$(id -u)" -eq 0 ] || exit 1
if [ "$#" -eq 0 ]; then
    pids=$(pidof psiosd) || pids=
    if [ -n "$pids" ]; then
        kill -TERM $pids
        i=0
        while pidof psiosd >/dev/null && [ "$i" -lt 150 ]; do sleep 0.1; i=$((i+1)); done
    fi
    # The shutdown hook runs before BusyBox signals login sessions. A console
    # shell can still hold /root or /home/psios as its working directory.
    kill -TERM -1 2>/dev/null || :
    sleep 1
    kill -KILL -1 2>/dev/null || :
elif [ "$#" -ne 1 ] || [ "$1" != --mounts-only ]; then
    exit 1
fi

mounted() {
    awk -v path="$1" '$5 == path { found=1; exit } END { exit !found }' /proc/self/mountinfo
}
if mounted /mnt/psios-homes; then sync -f /mnt/psios-homes; fi
if mounted /var/lib; then sync -f /var/lib; fi

close_mount() {
    mounted "$1" || return 0
    if ! umount "$1" 2>/dev/null && ! mount -o "$2" "$1"; then
        printf 'PsiOS shutdown could not close %s cleanly\n' "$1" >/dev/console
    fi
}
close_mount /home/psios remount,bind,ro
close_mount /root remount,bind,ro
close_mount /dev/shm remount,ro
close_mount /tmp remount,ro
close_mount /dev/pts remount,ro
close_mount /mnt/psios-homes remount,ro
close_mount /etc remount,bind,ro
close_mount /var/lib remount,ro
