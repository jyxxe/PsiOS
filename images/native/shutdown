#!/bin/sh
# BusyBox init has already ceased respawning services when this action runs.
[ "$PPID" -eq 1 ] && [ "$(id -u)" -eq 0 ] || exit 1
pids=$(pidof psiosd) || pids=
if [ -n "$pids" ]; then
    kill -TERM $pids
    i=0
    while pidof psiosd >/dev/null && [ "$i" -lt 150 ]; do sleep 0.1; i=$((i+1)); done
fi
# The init shutdown hook runs before BusyBox signals login sessions. A console
# shell can still hold /root or /home/psios as its working directory.
kill -TERM -1 2>/dev/null || :
sleep 1
kill -KILL -1 2>/dev/null || :
sync -f /mnt/psios-homes
sync -f /var/lib

close_mount() {
    if ! umount "$1" 2>/dev/null && ! mount -o "$2" "$1"; then
        printf 'PsiOS shutdown could not close %s cleanly\n' "$1" >/dev/console
    fi
}
close_mount /home/psios remount,bind,ro
close_mount /root remount,bind,ro
close_mount /mnt/psios-homes remount,ro
close_mount /etc remount,bind,ro
close_mount /var/lib remount,ro
