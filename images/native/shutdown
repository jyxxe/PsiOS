#!/bin/sh
# BusyBox init has already ceased respawning services when this action runs.
pids=$(pidof psiosd) || pids=
if [ -n "$pids" ]; then
    kill -TERM $pids
    i=0
    while pidof psiosd >/dev/null && [ "$i" -lt 150 ]; do sleep 0.1; i=$((i+1)); done
fi
sync -f /mnt/psios-homes
sync -f /var/lib
umount /home/psios || mount -o remount,bind,ro /home/psios
umount /root || mount -o remount,bind,ro /root
umount /mnt/psios-homes || mount -o remount,ro /mnt/psios-homes
umount /etc || mount -o remount,bind,ro /etc
umount /var/lib || mount -o remount,ro /var/lib
