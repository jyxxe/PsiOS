#!/bin/sh
set -eu
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
umask 022

config=/etc/psios
authorized=$config/ssh-authorized-key
key=$config/ssh_host_ed25519_key
pending=$config/.ssh-host-key.pending
runtime=/run/psios-ssh

valid_authorized_key() {
    [ -f "$1" ] && [ ! -L "$1" ] &&
        [ "$(stat -c '%u:%g:%a:%h' "$1")" = 0:0:644:1 ] &&
        [ "$(wc -c < "$1")" -eq 81 ] &&
        grep -Eq '^ssh-ed25519 [A-Za-z0-9+/]{68}$' "$1" &&
        ssh-keygen -lf "$1" >/dev/null
}

rotate_authorized_key() (
    if [ "$(id -u)" -ne 0 ]; then
        echo "Replacing the SSH operator key requires local root" >&2
        exit 1
    fi
    if [ "$#" -ne 1 ] || ! printf '%s\n' "$1" | grep -Eq '^[0-9a-f]{64}$'; then
        echo "Usage: sh /psios-ssh rotate-authorized-key EXPECTED_SHA256 < operator.pub" >&2
        exit 2
    fi
    [ -d "$config" ] && [ ! -L "$config" ] || exit 1
    case "$(stat -c '%u:%g:%a' "$config")" in 0:0:700|0:0:755) ;; *) exit 1 ;; esac
    exec 9< "$config"
    if ! /bin/busybox flock -n 9; then
        echo "Another SSH operator key rotation is running" >&2
        exit 1
    fi
    if ! valid_authorized_key "$authorized"; then
        echo "The installed SSH operator key is invalid" >&2
        exit 1
    fi
    current=$(sha256sum < "$authorized")
    if [ "${current%% *}" != "$1" ]; then
        echo "The installed SSH operator key digest differs from the expected digest" >&2
        exit 1
    fi
    staged=$config/.ssh-authorized-key.pending
    if [ -e "$staged" ] || [ -L "$staged" ]; then
        [ -f "$staged" ] && [ ! -L "$staged" ] || exit 1
        case "$(stat -c '%u:%g:%a:%h' "$staged")" in 0:0:600:1|0:0:644:1) ;; *) exit 1 ;; esac
        rm -f -- "$staged"
    fi
    (umask 077; set -C; : > "$staged")
    trap 'rm -f -- "$staged"' EXIT
    /bin/busybox timeout 8 /bin/busybox head -c 82 > "$staged"
    chmod 0644 "$staged"
    if ! valid_authorized_key "$staged"; then
        echo "Expected one canonical OpenSSH Ed25519 public key without a comment" >&2
        exit 1
    fi
    sync -f "$config"
    mv -T -- "$staged" "$authorized"
    sync -f "$config"
    trap - EXIT
    sha256sum "$authorized"
)

if [ "$#" -gt 0 ]; then
    if [ "$1" != rotate-authorized-key ]; then
        echo "Unknown PsiOS SSH command" >&2
        exit 2
    fi
    shift
    rotate_authorized_key "$@"
    exit
fi

fail() {
    trap - EXIT
    echo "PsiOS SSH console could not start" >&2
    exec sleep 30
}
trap fail EXIT
valid_authorized_key "$authorized"

if [ -e "$pending" ] || [ -L "$pending" ]; then
    [ -d "$pending" ] && [ ! -L "$pending" ]
    [ "$(stat -c '%u:%g:%a' "$pending")" = 0:0:700 ]
    rm -f -- "$pending/key" "$pending/key.pub"
    rmdir "$pending"
fi
if [ ! -e "$key" ] && [ ! -L "$key" ]; then
    mkdir -m 0700 "$pending"
    ssh-keygen -q -t ed25519 -N '' -C '' -f "$pending/key"
    sync -f /etc/psios
    mv -T "$pending/key" "$key"
    sync -f /etc/psios
    rm -f "$pending/key.pub"
    rmdir "$pending"
fi
[ -f "$key" ] && [ ! -L "$key" ]
[ "$(stat -c '%u:%g:%a:%h' "$key")" = 0:0:600:1 ]
[ "$(wc -c < "$key")" -le 2048 ]

mkdir -m 0755 -p /var/empty "$runtime"
[ -d /var/empty ] && [ ! -L /var/empty ] && [ "$(stat -c '%u:%g:%a' /var/empty)" = 0:0:755 ]
[ -d "$runtime" ] && [ ! -L "$runtime" ] && [ "$(stat -c '%u:%g:%a' "$runtime")" = 0:0:755 ]
public=$(ssh-keygen -y -P '' -f "$key" </dev/null)
case "$public" in 'ssh-ed25519 '*) ;; *) exit 1 ;; esac
printf '%s\n' "$public" > "$runtime/host-key.pub"
(umask 077; cat > "$runtime/sshd_config" <<'EOF'
Port 22
HostKey /etc/psios/ssh_host_ed25519_key
PidFile /run/psios-ssh/sshd.pid
AuthorizedKeysFile /etc/psios/ssh-authorized-key
AllowUsers psios
PermitRootLogin no
AuthenticationMethods publickey
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitUserEnvironment no
DisableForwarding yes
PermitUserRC no
LoginGraceTime 20
MaxStartups 4:50:8
MaxSessions 4
EOF
)
/usr/sbin/sshd -t -f "$runtime/sshd_config"
exec /usr/sbin/sshd -D -e -f "$runtime/sshd_config"
