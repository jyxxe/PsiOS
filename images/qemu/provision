#!/bin/sh
set -eu
cd /var/lib/psios-provision
mount -o ro,nosuid,nodev,noexec -L cidata /run/psios-provision
trap 'umount /run/psios-provision' EXIT
(cd /run/psios-provision && sha256sum --check /etc/psios-provision.sha256)
dpkg -i /run/psios-provision/psios-core.deb

# Record the one-time authorization before asking Core to create any identity.
# If initialization was interrupted, leave the node for local inspection.
if [ ! -e initialization-issued ]; then
    touch initialization-issued
    sync -f .
    systemctl start psios-init.service
fi
systemctl enable --now psiosd.service
for attempt in $(seq 1 100); do
    if runuser -u psios -- /usr/bin/psiosctl --socket /run/psios/api.sock node >/dev/null 2>&1; then
        touch complete
        sync -f .
        exit 0
    fi
    sleep 0.2
done
echo "Core API did not become ready; inspect journalctl -u psiosd" >&2
exit 1
