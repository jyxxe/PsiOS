#!/bin/sh
# Run as PID 1 in the pinned initramfs. Only the report uses the second UART.
set -eu
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
bb=/bin/busybox
stage=startup
finish() {
    if [ "$stage" != complete ]; then
        printf '\nPSIOS-RESCUE/1\nERROR %s\n' "$stage" > /dev/ttyS1
    fi
    "$bb" poweroff -f
}
trap finish EXIT
"$bb" mount -t devtmpfs devtmpfs /dev
"$bb" mount -t proc proc /proc
"$bb" mount -t sysfs sysfs /sys
"$bb" mkdir -p /source /scratch
# Generated by the launcher from validated numbers and hexadecimal.
. /rescue-settings
"$bb" mount -t tmpfs -o "size=${SCRATCH_MIB}m,mode=1777,nosuid,nodev,noexec" tmpfs /scratch
if [ "${SECURE_BOOT:-0}" = 1 ]; then
    stage=secure-boot-not-enforced
    "$bb" dmesg | "$bb" grep -Eiq 'secure boot enabled|locked down from EFI Secure Boot'
    printf '\nPSIOS-SECURE-BOOT/1\nEnforced\n' > /dev/ttyS1
fi
stage=block-device
/usr/sbin/modprobe virtio_blk
/usr/sbin/modprobe ext4
wait_for_disk() {
    local name=$1 attempt=0
    while [ ! -b "/dev/$name" ] && [ "$attempt" -lt 50 ]; do
        "$bb" sleep 0.1
        attempt=$((attempt+1))
    done
    [ -b "/dev/$name" ]
}
if [ -n "$FILESYSTEM_UUID" ]; then
    /usr/sbin/modprobe nvme_core multipath=0
    /usr/sbin/modprobe nvme async_probe=0
    if [ "$MANAGED_NVME" = 1 ]; then
        # Only the direct launcher sets this flag. The file and raw QEMU
        # backends are read-only even though NVMe does not advertise that.
        wait_for_disk nvme0n1
        "$bb" blockdev --setro /dev/nvme0n1
    fi
    disk=
    whole_disk=
    scanned=0
    stage=filesystem-identity
    for entry in /sys/class/block/vd* /sys/class/block/nvme*n*; do
        [ -r "$entry/size" ] || continue
        if [ -r "$entry/partition" ]; then
            [ "$("$bb" cat "$entry/partition")" = "$PARTITION" ] || continue
        else
            [ "$PARTITION" = 0 ] || continue
        fi
        scanned=$((scanned+1))
        if [ "$scanned" -gt 128 ]; then stage=filesystem-discovery-limit; exit 1; fi
        [ "$("$bb" cat "$entry/size")" -ge 3 ] || continue
        device=${entry##*/}
        [ -b "/dev/$device" ]
        encoded=$("$bb" od -An -v -j 1080 -N 64 -t x1 "/dev/$device")
        header=$(printf '%s' "$encoded" | "$bb" tr -d '[:space:]')
        [ "${#header}" -eq 128 ]
        case "$header" in
            53ef*) [ "$(printf '%s' "$header" | "$bb" cut -c97-128)" = "$FILESYSTEM_UUID" ] || continue ;;
            *) continue ;;
        esac
        if [ -n "$disk" ]; then stage=ambiguous-filesystem-identity; exit 1; fi
        disk=/dev/$device
        whole_disk=$device
        if [ "$PARTITION" != 0 ]; then
            location=$("$bb" readlink -f "$entry")
            parent=${location%/*}
            whole_disk=${parent##*/}
        fi
    done
    [ -n "$disk" ]
else
    whole_disk=vda
    device=vda
    if [ "$PARTITION" -gt 0 ]; then device=vda$PARTITION; fi
    wait_for_disk "$device"
    disk=/dev/$device
fi
stage=block-device
[ "$MANAGED_NVME" = 0 ] || [ "$whole_disk" = nvme0n1 ]
[ "$("$bb" cat "/sys/class/block/$whole_disk/ro")" = "$((1-OVERLAY))" ]
# ext superblock fields are little-endian on this x86_64 rescue profile.
stage=unsupported-filesystem
magic=$("$bb" od -An -j 1080 -N 2 -t u2 "$disk")
[ "$((magic))" = 61267 ]
stage=filesystem-recovery-required
read_state() {
    state=$("$bb" od -An -j 1082 -N 2 -t u2 "$disk")
    incompat=$("$bb" od -An -j 1120 -N 4 -t u4 "$disk")
    ro_compat=$("$bb" od -An -j 1124 -N 4 -t u4 "$disk")
}
clean() {
    [ "$((state))" = 1 ] && [ "$((incompat & 4))" = 0 ] && [ "$((ro_compat & 65536))" = 0 ]
}
read_state
status=OK
if [ "$OVERLAY" = 1 ]; then
    status='OK clean'
    if ! clean; then
        # Only a journaled filesystem with a pending recovery/orphan record
        # is eligible. Filesystems marked erroneous require separate repair.
        compat=$("$bb" od -An -j 1116 -N 4 -t u4 "$disk")
        [ "$((state & ~1))" = 0 ]
        [ "$((compat & 4))" = 4 ]
        [ "$(( (incompat & 4) | (ro_compat & 65536) ))" != 0 ]
        stage=journal-replay
        "$bb" mount -t ext4 -o ro,nodev,nosuid,noexec "$disk" /source
        "$bb" umount /source
        "$bb" blockdev --flushbufs "$disk"
        read_state
        status='OK replayed'
    fi
    "$bb" blockdev --setro "$disk"
fi
clean
[ "$("$bb" blockdev --getro "$disk")" = 1 ]
stage=mount
"$bb" mount -t ext4 -o ro,noload,nodev,nosuid,noexec "$disk" /source
stage=service-identity
# The upstream early-boot root is private to PID 1. Make this RAM filesystem
# traversable before dropping privileges; the inspected mount is read-only.
"$bb" chmod 0755 /
printf 'psioscheck:x:%s:%s::/:/bin/sh\n' "$SERVICE_UID" "$SERVICE_GID" >> /etc/passwd
printf 'psioscheck:x:%s:\n' "$SERVICE_GID" >> /etc/group
stage=authority-rejected
mode=
if [ "${REHEARSE:-0}" = 1 ]; then mode=--rehearse-migration; fi
if ! "$bb" su -s /bin/sh psioscheck -c \
    "SQLITE_TMPDIR=/scratch exec /psiosd --config /rescue.json verify --scratch-dir /scratch --max-copy-mib $COPY_MIB $mode" \
    > /report 2>/diagnostic; then
    prefix=authority
    if "$bb" grep -q 'migration rehearsal failed' /diagnostic; then prefix=migration-rehearsal; fi
    for code in QuotaExceeded PermissionDenied RecoveryRequired SchemaVersionUnsupported StorageUnavailable Conflict InvalidArgument; do
        if "$bb" grep -q "$code" /diagnostic; then stage=$prefix-$code; break; fi
    done
    exit 1
fi
stage=report
[ "$("$bb" wc -c < /report)" -le 65536 ]
{ printf '\nPSIOS-RESCUE/1\n%s\n' "$status"; "$bb" cat /report; } > /dev/ttyS1
stage=complete
