#!/bin/bash
# Export the standalone amd64 Linux binaries from the selected source commit.
set -euo pipefail
if [[ $# -lt 1 || $# -gt 2 ]]; then
    echo "usage: $0 NEW_TAR_GZ [GIT_REVISION]" >&2
    exit 2
fi
if [[ -e $1 || -L $1 ]]; then
    echo "output already exists" >&2
    exit 2
fi
output="$(realpath -e -- "$(dirname "$1")")/$(basename -- "$1")"
repo=$(git -C "$(dirname "$0")" rev-parse --show-toplevel)
sha=$(git -C "$repo" rev-parse --verify --end-of-options "${2:-HEAD}^{commit}")
epoch=$(git -C "$repo" show -s --format=%ct "$sha")
work=$(mktemp -d -- "$(dirname "$output")/.psios-portable.XXXXXXXX")
trap 'rm -rf -- "$work"' EXIT
build_options=()
if [[ -n ${CARGO_HTTP_CAINFO:-} ]]; then
    build_options+=(--secret "id=cargo_ca,src=$CARGO_HTTP_CAINFO")
fi
git -C "$repo" archive "$sha" Cargo.toml Cargo.lock crates docs/v1/schemas contrib/portable |
    docker buildx build "${build_options[@]}" --platform linux/amd64 --file contrib/portable/Dockerfile \
        --output "type=tar,dest=$work/binaries.tar" -
mkdir "$work/bundle"
cd "$work/bundle"
tar --same-permissions -xf "$work/binaries.tar" psiosd psiosctl
git -C "$repo" show "$sha:Cargo.lock" > Cargo.lock
printf '%s\n' "$sha" > source-commit
members=(Cargo.lock SHA256SUMS psiosctl psiosd source-commit)
checks=(psiosd psiosctl Cargo.lock source-commit)
# The selected revision determines its archive layout, including when rebuilding
# an older release with this launcher. Fetch every rescue file from that tree.
if git -C "$repo" cat-file -e "$sha:images/rescue/README.txt" 2>/dev/null; then
    mkdir -m 0755 rescue
    rescue_files=(README.txt base.json init inspect.py)
    if git -C "$repo" cat-file -e "$sha:images/rescue/boot_media.py" 2>/dev/null; then
        rescue_files+=(boot_media.py)
    fi
    git -C "$repo" archive "$sha:images/rescue" "${rescue_files[@]}" | tar --same-permissions -xf - -C rescue
    checks+=("${rescue_files[@]/#/rescue/}")
    members+=(rescue)
fi
if git -C "$repo" cat-file -e "$sha:images/native/README.txt" 2>/dev/null; then
    mkdir -m 0755 native
    native_files=(README.txt create.py init shutdown)
    if git -C "$repo" cat-file -e "$sha:images/native/dhcp" 2>/dev/null; then
        native_files+=(dhcp dhcp-event)
    fi
    if git -C "$repo" cat-file -e "$sha:images/native/ipv4" 2>/dev/null; then
        native_files+=(ipv4)
    fi
    if git -C "$repo" cat-file -e "$sha:images/native/ipv6" 2>/dev/null; then
        native_files+=(ipv6 static)
    fi
    if git -C "$repo" cat-file -e "$sha:images/native/storage" 2>/dev/null; then
        native_files+=(storage)
    fi
    if git -C "$repo" cat-file -e "$sha:images/native/enroll" 2>/dev/null; then
        native_files+=(enroll)
    fi
    if git -C "$repo" cat-file -e "$sha:images/native/core-cgroup" 2>/dev/null; then
        native_files+=(core-cgroup)
    fi
    if git -C "$repo" cat-file -e "$sha:images/native/install.py" 2>/dev/null; then
        native_files+=(install.py install_source.py install_target.py)
    fi
    git -C "$repo" archive "$sha:images/native" "${native_files[@]}" | tar --same-permissions -xf - -C native
    checks+=("${native_files[@]/#/native/}")
    members+=(native)
fi
sha256sum "${checks[@]}" > SHA256SUMS
tar --mtime="@$epoch" --owner=0 --group=0 --numeric-owner --mode='u+rw,go+r-w' \
    --sort=name -cf - "${members[@]}" | gzip -n > "$work/core.tar.gz"
# Hard-link from the same filesystem to publish only a complete, new archive.
ln -T -- "$work/core.tar.gz" "$output"
