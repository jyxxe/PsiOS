#!/bin/bash
# GitHub's Ubuntu image provides the signed archive and its mirror failover.
set -euo pipefail
sources=/etc/apt/sources.list.d/ubuntu.sources
if [[ ! -r "$sources" ]]; then
    echo "Ubuntu runner archive configuration is unavailable: $sources" >&2
    exit 1
fi
export DEBIAN_FRONTEND=noninteractive
exec /usr/bin/apt-get -o "Dir::Etc::sourcelist=$sources" -o Dir::Etc::sourceparts=- \
    -o Acquire::http::Timeout=15 -o Acquire::https::Timeout=15 \
    -o Acquire::Retries=1 -o Acquire::Languages=none -o APT::Update::Error-Mode=any "$@"
