#!/bin/bash
# Verify a downloaded main-branch development package against a trusted source revision.
set -euo pipefail
if [[ $# -lt 2 || $# -gt 4 || ! $2 =~ ^[0-9a-f]{40}$ ]]; then
    echo "usage: $0 UNPACKED_PACKAGE_DIR EXPECTED_FULL_MAIN_SHA [ATTESTATION_BUNDLE [TRUSTED_ROOT_JSONL]]" >&2
    exit 2
fi
root=$(realpath -e -- "$1")
expected=$2
shift 2
source "$(dirname "$0")/lib/attestation.sh"
shopt -s nullglob
packages=("$root"/psios-core_*_amd64.deb)
if [[ ${#packages[@]} != 1 ]]; then
    echo "expected exactly one amd64 Core package" >&2
    exit 1
fi
verify_core_attestation core.yml "$expected" "$root/SHA256SUMS" "$@"
verify_core_attestation core.yml "$expected" "${packages[0]}" "$@"
(cd -- "$root" && sha256sum --strict --check SHA256SUMS)
if [[ $(<"$root/source-commit") != "$expected" ]]; then
    echo "package source differs from the requested revision" >&2
    exit 1
fi
printf 'Verified %s from %s\n' "${packages[0]##*/}" "$expected"
